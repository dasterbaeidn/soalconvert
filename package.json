{
  "name": "soalconvert",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm build && tsx server/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:processor": "python3 tests/test_processor.py"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "@types/express": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "express": "latest",
    "multer": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {}
}
